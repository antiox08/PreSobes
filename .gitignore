# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables (secrets) — шаблон .env.example коммитим
.env

# IDE
.idea/
.vscode/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Allure: результаты прогона не коммитим, categories.json — да
reports/allure/*
!reports/allure/categories.json
!reports/allure/.gitkeep

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Build / distribution
build/
dist/
*.egg-info/

# Logs
*.log

# OS
.DS_Store

# Local misc
assets/
